diff --git a/video/out/vulkan/context_moltenvk.m b/video/out/vulkan/context_moltenvk.m
index 445b907..bab4a9b 100644
--- a/video/out/vulkan/context_moltenvk.m
+++ b/video/out/vulkan/context_moltenvk.m
@@ -73,11 +73,22 @@ static bool moltenvk_init(struct ra_ctx *ctx)
     return false;
 }
 
+// The host app owns the layer and reports its pixel size through
+// --moltenvk-surface-size (which triggers VOCTRL_EXTERNAL_RESIZE), the same
+// contract as --android-surface-size. Falls back to the layer's own size.
 static bool moltenvk_reconfig(struct ra_ctx *ctx)
 {
     struct priv *p = ctx->priv;
-    CGSize s = p->layer.drawableSize;
-    ra_vk_ctx_resize(ctx, s.width, s.height);
+    int w = ctx->vo->opts->moltenvk_surface_size.w,
+        h = ctx->vo->opts->moltenvk_surface_size.h;
+    if (w <= 0 || h <= 0) {
+        CGSize s = p->layer.drawableSize;
+        w = s.width;
+        h = s.height;
+    }
+    if (w <= 1 || h <= 1)
+        return false;
+    ra_vk_ctx_resize(ctx, w, h);
     return true;
 }
 
