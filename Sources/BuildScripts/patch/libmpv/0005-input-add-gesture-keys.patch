+// Touch gestures, injected by a host app through the keypress/keydown/keyup commands.
+// Continuous gestures (vertical slide, pinch) arrive as repeated presses, like wheel ticks.
+#define MP_KEY_GESTURE                    (MP_KEY_BASE+0x200)
+#define MP_KEY_GESTURE_TAP                     (MP_KEY_GESTURE+0)
+#define MP_KEY_GESTURE_DOUBLE_TAP_LEFT         (MP_KEY_GESTURE+1)
+#define MP_KEY_GESTURE_DOUBLE_TAP_CENTER       (MP_KEY_GESTURE+2)
