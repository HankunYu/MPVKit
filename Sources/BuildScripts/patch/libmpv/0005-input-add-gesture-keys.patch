+#define MP_KEY_GESTURE_LEFT_UP                 (MP_KEY_GESTURE+4)
+#define MP_KEY_GESTURE_LEFT_DOWN               (MP_KEY_GESTURE+5)
+#define MP_KEY_GESTURE_RIGHT_UP                (MP_KEY_GESTURE+6)
+#define MP_KEY_GESTURE_RIGHT_DOWN              (MP_KEY_GESTURE+7)
+#define MP_KEY_GESTURE_PINCH_IN                (MP_KEY_GESTURE+8)
+#define MP_KEY_GESTURE_PINCH_OUT               (MP_KEY_GESTURE+9)
+#define MP_KEY_GESTURE_HOLD                    (MP_KEY_GESTURE+10)
+
 // Reserved area. Can be used for keys that have no explicit names assigned,
